import pepita.*
import comidas.*
import silvestre.*
import direcciones.*
import obstaculos.*
import wollok.game.*

program PepitaGame {
	game.title("El titulo")
	game.height(10)
	game.width(10)
	game.boardGround("fondo2.jpg")
	game.addVisual(alpiste)
	//game.addVisual(manzana)
	game.addVisual(muro)
	game.addVisual(nido)
	game.addVisual(silvestre)
	game.addVisual(pepita)
	game.onCollideDo(pepita,{elemento=>elemento.teChocaron()})
	direcciones.movimientos(pepita)
	
	

	// keyboard.left().onPressDo({ pepita.mover(izquierda)})
	// keyboard.right().onPressDo({ pepita.mover(derecha)})
	// keyboard.up().onPressDo({ pepita.mover(arriba)})
	// keyboard.down().onPressDo({ pepita.mover(abajo)})

	game.start()
}
